{
  "name": "vb-serve-tracker",
  "private": true,
  "scripts": {
    "lint": "eslint --max-warnings 0 . && node scripts/lint-inline.js",
    "test": "npm run test:unit",
    "test:unit": "node test.js",
    "test:uat": "playwright test",
    "test:uat:iphone": "playwright test --project=iphone-safari",
    "test:visual": "playwright test e2e/visual-regression.spec.js --project=iphone-safari",
    "test:visual:update": "npm run test:visual -- --update-snapshots",
    "test:all": "npm run test:unit && npm run test:uat",
    "check": "npm run lint && npm run test:all"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "serve": "^14.2.4"
  }
}
